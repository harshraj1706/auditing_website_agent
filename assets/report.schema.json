{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand AI-Readiness Audit Report",
  "type": "object",
  "required": ["site", "audited_at", "summary", "findings"],
  "properties": {
    "site": { "type": "string" },
    "audited_at": { "type": "string" },
    "site_type": { "type": "string" },
    "site_scale": { "type": "object" },
    "raw_signals": { "type": "object" },
    "synthesis_mode": { "type": "string" },
    "self_check_failed": { "type": "boolean" },
    "self_check_finding_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium"],
      "properties": {
        "total_findings": { "type": "integer" },
        "critical": { "type": "integer" },
        "high": { "type": "integer" },
        "medium": { "type": "integer" },
        "low": { "type": "integer" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "evidence", "suggested_action"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "evidence": { "type": "string" },
          "category": { "enum": ["discoverability", "engagement"] },
          "failure_mode": { "type": "string" },
          "confidence": { "type": "number" },
          "confidence_note": { "type": "string" },
          "affected_urls": {
            "type": "array",
            "items": { "type": "string" }
          },
          "signals": { "type": "object" },
          "synthesis": { "type": "object" },
          "grounding": { "type": "object" },
          "self_check_failed": { "type": "boolean" },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": { "type": "string" },
              "priority": { "type": "string" },
              "how": { "type": "string" }
            }
          }
        }
      }
    },
    "proactive_recommendations": { "type": "array" },
    "limitations": { "type": "object" }
  }
}
